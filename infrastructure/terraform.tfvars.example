aws_region   = "us-east-1"
project_name = "conference-app"

# RDS PostgreSQL (reservations service)
db_instance_class = "db.t3.micro"
db_name           = "conference"
db_username       = "conference_admin"
db_password       = "ChangeThisStrongPassword123!"

# Container image tag pushed to ECR via scripts/build-and-push.ps1
image_tag = "latest"

# Fargate scaling
service_desired_count = 2
service_min_capacity  = 2
service_max_capacity  = 4
task_cpu              = "256"
task_memory           = "512"
